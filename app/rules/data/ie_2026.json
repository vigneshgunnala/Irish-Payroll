  "rules": [
    {"rule_id": "PAYE-2026-RATE-STD", "category": "PAYE", "parameter": "standard_rate", "value": "0.20", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_TAX_CHART", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "\"€44,000 @ 20%, balance @ 40%\" (single). 20% standard rate."},
    {"rule_id": "PAYE-2026-RATE-HIGH", "category": "PAYE", "parameter": "higher_rate", "value": "0.40", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_TAX_CHART", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "Balance above the standard rate cut-off point taxed at 40%."},
    {"rule_id": "PAYE-2026-SRCOP-SINGLE", "category": "PAYE", "parameter": "srcop_single", "value": "44000", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_TAX_CHART", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "Single / widowed without dependent children. Reference only - the employee's actual SRCOP comes from their RPN."},
    {"rule_id": "PAYE-2026-SRCOP-ONEPARENT", "category": "PAYE", "parameter": "srcop_one_parent", "value": "48000", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_TAX_CHART", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "Single / widowed qualifying for Single Person Child Carer Credit. Reference only."},
    {"rule_id": "PAYE-2026-SRCOP-MARRIED1", "category": "PAYE", "parameter": "srcop_married_one_income", "value": "53000", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_TAX_CHART", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "Married / civil partners, one income. Reference only."},
    {"rule_id": "PAYE-2026-SRCOP-MARRIED2-INC", "category": "PAYE", "parameter": "srcop_married_two_income_max_increase", "value": "35000", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_TAX_CHART", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "Married two incomes: €53,000 with an increase of up to €35,000. Reference only."},
    {"rule_id": "PAYE-2026-CREDIT-PERSONAL-SINGLE", "category": "PAYE", "parameter": "credit_personal_single", "value": "2000", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_TAX_CHART", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "Reference only; RPN credits are authoritative."},
    {"rule_id": "PAYE-2026-CREDIT-PERSONAL-MARRIED", "category": "PAYE", "parameter": "credit_personal_married", "value": "4000", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_TAX_CHART", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "Reference only."},
    {"rule_id": "PAYE-2026-CREDIT-EMPLOYEE", "category": "PAYE", "parameter": "credit_employee", "value": "2000", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_TAX_CHART", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "Employee (PAYE) tax credit. Reference only."},
    {"rule_id": "PAYE-2026-PERIOD-ROUNDING", "category": "PAYE", "parameter": "period_amount_rounding", "value": "ROUND_UP_CENT", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_EMERGENCY_PDF", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "Revenue's own periodised figures round up to the next cent: €44,000/52 = 846.1538 is published as €846.16 (weekly emergency cut-off). Applied to periodised cut-offs and credits."},

    {"rule_id": "EMRG-2026-SRCOP-WEEKLY", "category": "EMERGENCY", "parameter": "srcop_weekly_weeks_1_4", "value": "846.16", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_EMERGENCY_PDF", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "PPSN provided: weekly cut-off €846.16 in weeks 1-4, €0.00 thereafter (all at 40%)."},
    {"rule_id": "EMRG-2026-SRCOP-WEEKS", "category": "EMERGENCY", "parameter": "srcop_weekly_weeks_count", "value": "4", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_EMERGENCY_BASIS", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "\"An employer must give the employee a tax cut-off point for their first four weeks of employment.\""},
    {"rule_id": "EMRG-2026-SRCOP-MONTHLY", "category": "EMERGENCY", "parameter": "srcop_monthly_month_1", "value": "3666.67", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_EMERGENCY_PDF", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "PPSN provided: monthly cut-off €3,666.67 in month 1, €0.00 thereafter."},
    {"rule_id": "EMRG-2026-CREDITS", "category": "EMERGENCY", "parameter": "tax_credits", "value": "0", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_EMERGENCY_PDF", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "No tax credits on the emergency basis."},
    {"rule_id": "EMRG-2026-USC-RATE", "category": "EMERGENCY", "parameter": "usc_rate", "value": "0.08", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_EMERGENCY_PDF", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "Emergency USC: 8% on all USC pay, €0.00 cut-offs, all periods."},

    {"rule_id": "USC-2026-BANDS", "category": "USC", "parameter": "standard_bands", "value": [
        {"upper": "12012", "rate": "0.005"},
        {"upper": "28700", "rate": "0.02"},
        {"upper": "70044", "rate": "0.03"},
        {"upper": null, "rate": "0.08"}
      ], "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_USC_STD", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "\"First €12,012 0.5% | Next €16,688 2% | Next €41,344 3% | Balance 8%\" (2026). 2% ceiling raised from €27,382 to €28,700 in Budget 2026."},
    {"rule_id": "USC-2026-EXEMPT-THRESHOLD", "category": "USC", "parameter": "exemption_threshold", "value": "13000", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_USC_OVERVIEW", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "\"If your total income exceeds €13,000, you pay USC on your full income.\" Exemption status is determined by Revenue and delivered on the RPN; the engine does not self-assess it."},
    {"rule_id": "USC-2026-REDUCED-BANDS", "category": "USC", "parameter": "reduced_bands", "value": [
        {"upper": "12012", "rate": "0.005"},
        {"upper": null, "rate": "0.02"}
      ], "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_USC_REDUCED", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "\"0.5% on the first €12,012 and 2% on the balance.\" For age 70+ or full medical card holders with income ≤ €60,000. Applied only when the RPN USC status is REDUCED."},
    {"rule_id": "USC-2026-REDUCED-LIMIT", "category": "USC", "parameter": "reduced_income_limit", "value": "60000", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_USC_REDUCED", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "Reduced rate only where income is €60,000 or less. Used for a validation warning."},

