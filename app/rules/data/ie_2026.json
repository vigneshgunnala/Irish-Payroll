    {"rule_id": "BIK-2026-MEDICAL", "category": "BIK", "parameter": "medical_insurance_valuation", "value": "GROSS_PREMIUM", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_BIK_MEDICAL", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "\"The value of the benefit, to your employee, is the gross value of the insurance premium.\" Employee relief (20% of gross premium) comes through their tax credits on the RPN, not the payroll engine."},
