    {"rule_id": "PRSI-2026-PERIOD-CONVERSION", "category": "PRSI", "parameter": "weeks_per_period", "value": {"WEEKLY": "1", "FORTNIGHTLY": "2", "MONTHLY": "4.333333333333"}, "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "DSP_SW14_2026", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "Weekly thresholds are scaled by 52/12 for monthly pay. Evidence: SW14 monthly bands A0 '€165* to €1,525', AX to '€1,837', AL to '€2,392' = €38/€352/€424/€552 x 52/12. The same scaling is applied to the €12 credit (max €52/month) - SW14 only shows the credit weekly, so this is documented in LIMITATIONS.md."},

    {"rule_id": "LPT-2026-METHOD", "category": "LPT", "parameter": "deduction_method", "value": "EQUAL_SPREAD_FROM_RPN", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_LPT_DEDUCTION", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "\"LPT may be deducted at source from employees' wages where it is shown on the employee's Revenue Payroll Notification (RPN)... LPT payments are spread equally over the year.\" The engine only deducts the amount on the RPN; it never computes an LPT liability itself."},

    {"rule_id": "PEN-2026-AGE-LIMITS", "category": "PENSION", "parameter": "age_related_limits", "value": [
        {"min_age": 0, "percent": "0.15"},
        {"min_age": 30, "percent": "0.20"},
        {"min_age": 40, "percent": "0.25"},
        {"min_age": 50, "percent": "0.30"},
        {"min_age": 55, "percent": "0.35"},
        {"min_age": 60, "percent": "0.40"}
      ], "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_PENSION_LIMITS", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "Under 30 15%; 30-39 20%; 40-49 25%; 50-54 30%; 55-59 35%; 60+ 40%."},
    {"rule_id": "PEN-2026-EARNINGS-CAP", "category": "PENSION", "parameter": "earnings_cap", "value": "115000", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_PENSION_LIMITS", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "\"The maximum amount of earnings taken into account for calculating tax relief is €115,000 per year.\""},
    {"rule_id": "PEN-2026-TREATMENT", "category": "PENSION", "parameter": "employee_contribution_treatment", "value": {
        "OCCUPATIONAL": {"relieve_paye": true, "relieve_usc": false, "relieve_prsi": false},
        "AVC": {"relieve_paye": true, "relieve_usc": false, "relieve_prsi": false},
        "PRSA": {"relieve_paye": true, "relieve_usc": false, "relieve_prsi": false},
        "RAC": {"relieve_paye": false, "relieve_usc": false, "relieve_prsi": false}
      }, "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_EMPLOYERS_GUIDE", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "Net pay arrangement: ordinary superannuation contributions deducted before tax. \"There is no relief from Universal Social Charge (USC) or Pay Related Social Insurance (PRSI) for employee pension contributions\" (REV_PENSION_RELIEF). RAC premiums are not relieved through payroll - the employee claims relief directly."},

    {"rule_id": "BIK-2026-NOTIONAL-PAY", "category": "BIK", "parameter": "notional_pay_treatment", "value": {"paye": true, "usc": true, "prsi": true}, "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_EMPLOYERS_GUIDE", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "\"The value of any non-cash benefit or perquisite (called 'Notional Pay') must be added to pay and tax, USC and PRSI must be applied in the normal way.\""},
    {"rule_id": "BIK-2026-CAR-OMV-REDUCTION", "category": "BIK", "parameter": "car_omv_reduction", "value": {"A1": "10000", "A": "10000", "B": "10000", "C": "10000", "D": "10000", "E": "0"}, "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_BIK_CAR", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "€10,000 OMV reduction for 2026 (categories A1-D, not E); tapers to €5,000 in 2027 and €2,500 in 2028 (Budget 2026)."},
    {"rule_id": "BIK-2026-CAR-EV-REDUCTION", "category": "BIK", "parameter": "car_ev_additional_reduction", "value": "20000", "effective_from": "2026-01-01", "effective_to": "2026-12-31", "source": "REV_BIK_CAR", "verified_date": "2026-09-21", "status": "VERIFIED", "notes": "Category A1 (0g/km): \"an additional reduction to the Original Market Value of €20,000 will apply for 2026.\""},
