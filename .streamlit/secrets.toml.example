# Streamlit Community Cloud → your app → Settings → Secrets. Paste this, with your own values.
# Root-level keys are exposed to the app as environment variables.
PAYROLL_ENV = "demo"
PAYROLL_SECRET_KEY = "paste-output-of: python -c 'import secrets;print(secrets.token_urlsafe(48))'"
PAYROLL_AUTO_SEED = "true"
PAYROLL_PUBLIC_DEMO = "true"
PAYROLL_DEMO_PASSWORD = "choose-a-private-owner-password"   # owner sign-in; never shown to visitors
# Optional: persistent PostgreSQL (e.g. Neon). Leave out to use the built-in SQLite demo database,
# which is rebuilt automatically whenever the app restarts.
# PAYROLL_DATABASE_URL = "postgresql+psycopg://user:password@host/dbname?sslmode=require"
